# ClaimRush analytics config (example)
#
# Purpose: leaderboards + off-chain UI lists + Dune parameter defaults
#
# All contract addresses and start blocks below are placeholders (0x000...0).
# Fill them from deployments/base_mainnet.json after deployment.
# Aerodrome infrastructure addresses (WETH, Router, Factory) are canonical
# Base mainnet values and are pre-filled in the deployment manifest.
#
# IMPORTANT: Query hygiene
# - Compute multi-row outputs in the query/indexer layer (never FE-only filtering).
# - Apply all filters before ORDER BY / LIMIT / pagination.
#
# Source of truth for deployed addresses + start blocks:
# - deployments/base_mainnet.json

# Chain selection (informational; used for naming schemas/tables in analytics code)
CHAIN_NAME=base

# RPC URLs (optional, only needed if your backend resolves Basename/ENS display names)
# - Base RPC: for Basename direct resolver fallback
# - Mainnet RPC: for ENS primary name resolution
BASE_RPC_URL=
MAINNET_RPC_URL=

# Core contracts (set after deployment)
CLAIM_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VECLAIMNFT_ADDRESS=0x0000000000000000000000000000000000000000
MINECORE_ADDRESS=0x0000000000000000000000000000000000000000
SHAREHOLDER_ROYALTIES_ADDRESS=0x0000000000000000000000000000000000000000
FURNACE_ADDRESS=0x0000000000000000000000000000000000000000
MARKETROUTER_ADDRESS=0x0000000000000000000000000000000000000000
CLAIM_ALL_HELPER_ADDRESS=0x0000000000000000000000000000000000000000
MAINTENANCE_HUB_ADDRESS=0x0000000000000000000000000000000000000000
DELEGATION_HUB_ADDRESS=0x0000000000000000000000000000000000000000
MINECORE_QUOTER_ADDRESS=0x0000000000000000000000000000000000000000
AGENT_LENS_ADDRESS=0x0000000000000000000000000000000000000000

# Start blocks (deployment blocks)
CLAIM_TOKEN_START_BLOCK=0
VECLAIMNFT_START_BLOCK=0
MINECORE_START_BLOCK=0
SHAREHOLDER_ROYALTIES_START_BLOCK=0
FURNACE_START_BLOCK=0
MARKETROUTER_START_BLOCK=0
CLAIM_ALL_HELPER_START_BLOCK=0
MAINTENANCE_HUB_START_BLOCK=0
DELEGATION_HUB_START_BLOCK=0
MINECORE_QUOTER_START_BLOCK=0
AGENT_LENS_START_BLOCK=0

# Aerodrome config (set after deployment)
WETH_ADDRESS=0x0000000000000000000000000000000000000000
WETH_START_BLOCK=0

AERODROME_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
AERODROME_ROUTER_START_BLOCK=0

AERODROME_POOL_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
AERODROME_POOL_FACTORY_START_BLOCK=0

AERODROME_CLAIM_WETH_POOL_ADDRESS=0x0000000000000000000000000000000000000000
AERODROME_CLAIM_WETH_POOL_START_BLOCK=0

AERODROME_LP_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
AERODROME_LP_TOKEN_START_BLOCK=0

# Genesis LP vault (required)
GENESIS_LP_VAULT24M_ADDRESS=0x0000000000000000000000000000000000000000
GENESIS_LP_VAULT24M_START_BLOCK=0

# Launch controller (required)
LAUNCH_CONTROLLER_ADDRESS=0x0000000000000000000000000000000000000000
LAUNCH_CONTROLLER_START_BLOCK=0

# Dune decoding schema (replace with your Dune decoded contract schema)
# Recommended: create one Dune Project and add all ClaimRush addresses to it.
# Then queries can use a single schema:
#   <YOUR_SCHEMA>.MineCore_evt_Takeover
#   <YOUR_SCHEMA>.MineCore_evt_ReignFinalized
#   <YOUR_SCHEMA>.ShareholderRoyalties_evt_ShareholderClaim
#   <YOUR_SCHEMA>.Furnace_evt_FurnaceEnter
DUNE_DECODED_SCHEMA=your_dune_schema_here

# Entry token registries (two-registry model) + DEX adapter (recommended for token-entry decoding + application token coverage + transparency panels)
# deployments manifest keys: FurnaceEntryTokenRegistry + MineCoreEntryTokenRegistry + DexAdapter
FURNACE_ENTRY_TOKEN_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
FURNACE_ENTRY_TOKEN_REGISTRY_START_BLOCK=0

MINECORE_ENTRY_TOKEN_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
MINECORE_ENTRY_TOKEN_REGISTRY_START_BLOCK=0

# Dune helper: single start block for EntryTokenRegistry event templates
# Set to the minimum of the two registry start blocks above.
ENTRY_TOKEN_REGISTRY_START_BLOCK=0

# Compatibility single-registry key (do not use for v1.0.0+)
# ENTRY_TOKEN_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

DEX_ADAPTER_ADDRESS=0x0000000000000000000000000000000000000000
DEX_ADAPTER_START_BLOCK=0

# LP staking vault (optional in v1.0.0, but required if you surface APR panels)
LP_STAKING_VAULT7D_ADDRESS=0x0000000000000000000000000000000000000000
LP_STAKING_VAULT7D_START_BLOCK=0

# Protocol parameters (from protocolParams.furnace in deployments manifest)
SWING_TIME_SECONDS=5184000
